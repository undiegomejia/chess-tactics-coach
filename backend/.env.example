# Path to the Stockfish binary. Find yours with `which stockfish` (macOS/Linux)
# or the install path on Windows.
STOCKFISH_PATH=/usr/local/bin/stockfish

# SQLite for now -- rough phase, no need for Postgres yet.
DATABASE_URL=sqlite:///./data/chess.db

# Anthropic API key for Claude.
CLAUDE_API_KEY="anthropic_api_key_here"